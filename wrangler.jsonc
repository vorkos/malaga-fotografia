{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "photography",
  "main": "_worker.js",
  "compatibility_date": "2026-06-18",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Without this, requests matching a static asset are served before
    // _worker.js runs, so the canonical host/scheme redirect never fires.
    "run_worker_first": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "r2_buckets": [
    { "binding": "PHOTOS", "bucket_name": "photos" }
  ],
  // Throttles POST /api/apply. The form's honeypot only stops naive bots;
  // without this a loop could write R2 objects and fire Resend emails without
  // limit. Five per minute per IP — far above any genuine applicant.
  // _worker.js guards on the binding, so a deploy without it still works.
  "ratelimits": [
    {
      "name": "APPLY_RATE",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  // TFP Apply form (/apply/ -> POST /api/apply). Applications are stored in R2
  // under applications/. Email notification is optional: it activates once the
  // RESEND_API_KEY secret is set (`wrangler secret put RESEND_API_KEY`). Until
  // then applications still save to R2. APPLY_NOTIFY_TO must be the address your
  // Resend account owns (test sender can only email the account owner).
  "vars": {
    "APPLY_NOTIFY_TO": "boss138@gmail.com",
    "APPLY_FROM": "Málaga Fotografía <onboarding@resend.dev>"
  },
  // Resend API key lives in the account Secrets Store (secret name "resend" in
  // default_secrets_store). Accessed in the Worker via `await env.RESEND_API_KEY.get()`.
  "secrets_store_secrets": [
    {
      "binding": "RESEND_API_KEY",
      "store_id": "d86cc48d2b9e44068cd94bc34f40179e",
      "secret_name": "resend"
    }
  ]
}
