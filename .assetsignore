# Files under the repo root that must NOT be uploaded as public assets.
# `wrangler.jsonc` sets assets.directory to "." — the whole repo — so anything
# not listed here is served at https://malaga-fotografia.com/<path>.
#
# Assume NOTHING is excluded for you. Wrangler skips `.dev.vars*` and
# `node_modules`, but it does NOT skip dotfiles in general: until 2026-07-26 the
# entire `.git` directory was live, so `curl https://malaga-fotografia.com/.git/
# config` returned 200 and the whole repository — every commit, every branch —
# could be reconstructed by anyone. The Workers Builds log lists each uploaded
# path; read it after changing this file rather than trusting a spot check.

# --- version control and build scratch: NEVER public ---
.git
.gitignore
.gitattributes
.wrangler
.dev.vars
.dev.vars.example

# --- worker + config ---
_worker.js
wrangler.jsonc
.assetsignore
package.json
package-lock.json
README.md
node_modules

# --- sources and build tooling (only the built pages ship) ---
src
.agent
.claude
blog/build.mjs
blog/build-site.mjs
blog/build-apply.mjs
blog/lib
blog/content
blog/tools
blog/gallery-dims.json
blog/gallery-thumbs.json

# --- one-off scripts and working notes ---
fix_slots.py
check_slots.py
update_gallery.py
rate.html
orientations.txt

# --- screenshots and scratch. These were absent from the live site only
#     because they are untracked and deploys run from a clean checkout; a
#     local `wrangler deploy` would have published ~1.2 MB of them. ---
photo-grid.jpeg
gallery-page1.jpeg
gallery-page2.jpeg
gallery-page3.jpeg
rate-tool.jpeg
rate2-tool.jpeg
.playwright-mcp
